# AutoFlow AI Configuration

# Server
PORT=3000

# Database
DATABASE_PATH=./data/autoflow.db

# Encryption key for credentials (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-256-bit-hex-encryption-key-here

# Gemini API Key (for AI nodes)
GEMINI_API_KEY=your-gemini-api-key-here

# Webhook Base URL (used for webhook trigger display)
WEBHOOK_BASE_URL=http://localhost:3000
